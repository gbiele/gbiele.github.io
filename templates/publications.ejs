<%
const groups = [];
const byYear = Object.create(null);
for (const item of items) {
  const y = String(item.year || "");
  if (!byYear[y]) {
    byYear[y] = [];
    groups.push({ year: y, items: byYear[y] });
  }
  byYear[y].push(item);
}
%>
<div class="list pub-list">
<% for (const group of groups) { %>
<section class="pub-year" data-year="<%- group.year %>">
<h3 class="pub-year-heading"><%- group.year %></h3>
<% for (const item of group.items) { %>
<article class="pub-entry" data-key="<%- item.key %>" data-year="<%- item.year %>" data-pub-type="<%- item.pub_type %>" <%= metadataAttrs(item) %>>
<div class="pub-header">
<% if (item.pub_type === "preprint") { %>
<span class="pub-badge pub-badge-preprint">Preprint</span>
<% } else { %>
<span class="pub-badge pub-badge-type"><%- item.type_label %></span>
<% } %>
<div class="pub-title"><%= item.title_html %></div>
</div>
<div class="pub-authors"><%= item.authors_html %></div>
<div class="pub-venue"><%= item.venue_html %></div>
<% if (item.links && item.links.length > 0) { %>
<div class="pub-links">
<% for (const link of item.links) { %>
<a class="pub-link" href="<%- link.href %>"><%- link.label %></a>
<% } %>
</div>
<% } %>
<% if (item.abstract_html) { %>
<details class="pub-abstract">
<summary>Abstract</summary>
<p><%= item.abstract_html %></p>
</details>
<% } %>
</article>
<% } %>
</section>
<% } %>
</div>
