<div class="list research-interest-overview">
<% for (const item of items) { %>
<section class="research-interest" id="<%- item.id %>" data-interest-id="<%- item.id %>">
<p class="research-interest-description"><%- item.description %></p>
<% if (item.papers && item.papers.length > 0) { %>
<div class="research-interest-papers">
<h2 class="research-interest-papers-heading">Highlighted papers</h2>
<ul class="highlighted-papers-list">
<% for (const paper of item.papers) { %>
<li class="highlighted-paper" data-key="<%- paper.key %>" data-year="<%- paper.year %>">
<div class="highlighted-paper-title"><%= paper.title_html %></div>
<div class="highlighted-paper-authors"><%= paper.authors_html %></div>
<div class="highlighted-paper-meta"><span class="highlighted-paper-venue"><%= paper.venue_html %></span> (<span class="highlighted-paper-year"><%- paper.year %></span>)</div>
<% if (paper.links && paper.links.length > 0) { %>
<div class="pub-links">
<% for (const link of paper.links) { %>
<a class="pub-link" href="<%- link.href %>"><%- link.label %></a>
<% } %>
</div>
<% } %>
</li>
<% } %>
</ul>
</div>
<% } %>
</section>
<% } %>
</div>
